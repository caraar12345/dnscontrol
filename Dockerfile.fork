# syntax = docker/dockerfile:1.4
#
# Fork-specific image: builds from source (this repo, including the
# TECHNITIUM provider) instead of using GoReleaser-built binaries like the
# upstream Dockerfile does. Not a replacement for Dockerfile — that one stays
# untouched so it keeps merging cleanly from upstream.

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS BUILD

ARG TARGETARCH
ARG VERSION=dev

WORKDIR /src
COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH \
    go build -ldflags "-s -w -X github.com/DNSControl/dnscontrol/v4/pkg/version.version=${VERSION}" \
    -o /out/dnscontrol .

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS RUN

RUN apk update && apk add --no-cache tzdata ca-certificates && update-ca-certificates

COPY --from=BUILD /out/dnscontrol /usr/local/bin/dnscontrol

WORKDIR /dns

ENTRYPOINT ["/usr/local/bin/dnscontrol"]
